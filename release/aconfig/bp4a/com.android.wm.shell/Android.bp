// Force taskbar-on-phones OFF (Palm PVG100 / pepito, sw436dp). Two halves must agree:
//  1) SystemUI supportsTaskbar() reads this flag -> false means SystemUI hosts its own
//     NavigationBar (3-button insets correctly on the tiny panel).
//  2) Launcher3 TaskbarManagerImpl.isTaskbarEnabled() is patched to read the SAME flag, so
//     it stops adding a second TYPE_NAVIGATION_BAR window (which otherwise BadTokenException-
//     crash-loops Trebuchet). See packages/apps/Launcher3 patch + PLAN-misc.md §2.
// READ_ONLY so the GMS multitasking device_config push can't re-enable it at runtime.
aconfig_values {
    name: "aconfig-values-lineage-bp4a-com.android.wm.shell-all",
    package: "com.android.wm.shell",
    srcs: [
        "*_flag_values.textproto",
    ],
}
